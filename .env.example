# Example environment variables for Fitness Tracker backend

# Server configuration
# Port on which the API server will listen
PORT=8080
# Comma-separated browser origins allowed to call the API. Leave empty locally to allow all origins.
CORS_ALLOWED_ORIGINS=

# Database configuration
# Local Postgres can use sslmode=disable. Hosted Postgres such as Neon should use sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitness_tracker?sslmode=disable
# Optional override used only by docker compose. Defaults to the internal `db` service.
DOCKER_DATABASE_URL=

# JWT configuration
# Secret key used to sign access tokens
ACCESS_SECRET=access-secret
# Secret key used to sign refresh tokens
REFRESH_SECRET=refresh-secret

# Groq LLM service configuration
# Create a key in Groq Console and keep it secret.
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Optional: set other variables as needed
# e.g. LOG_LEVEL=info
